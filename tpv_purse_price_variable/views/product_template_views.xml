<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_pos_variable_price" model="ir.ui.view">
        <field name="name">product.template.form.pos.variable.price</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='pos']//group[@name='pos']" position="inside">
                <field name="pos_variable_price"
                       string="Precio modificable"
                       help="Si está activo, al seleccionar este producto en el POS se pedirá el precio."/>
            </xpath>
        </field>
    </record>
</odoo>

