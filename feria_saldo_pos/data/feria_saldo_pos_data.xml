<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Auxiliary product: every linked cobro becomes one POS order line with this product, priced at the cobro -->
        <record id="product_feria_charge" model="product.product">
            <field name="name">Cobro monedero feria</field>
            <field name="default_code">FERIA-COBRO</field>
            <field name="type">service</field>
            <field name="list_price">0</field>
            <field name="available_in_pos" eval="True"/>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="taxes_id" eval="[Command.clear()]"/>
        </record>

        <record id="ir_config_parameter_pos_product" model="ir.config_parameter">
            <field name="key">feria.pos_product_id</field>
            <field name="value" eval="str(ref('product_feria_charge'))"/>
        </record>

        <record id="ir_config_parameter_pos_link" model="ir.config_parameter">
            <field name="key">feria.pos_link</field>
            <field name="value">False</field>
        </record>
    </data>

    <data noupdate="0">
        <record id="ir_cron_pos_link_sync" model="ir.cron">
            <field name="name">Feria: enviar al TPV los cobros pendientes</field>
            <field name="model_id" ref="model_feria_pos_link"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
        </record>
    </data>
</odoo>
