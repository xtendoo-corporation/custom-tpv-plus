<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="feria_pos_link_view_list" model="ir.ui.view">
        <field name="name">feria.pos.link.view.list</field>
        <field name="model">feria.pos.link</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-warning="state in ('pending', 'review')" decoration-muted="state == 'cancelled'">
                <field name="received_at"/>
                <field name="partner_id"/>
                <field name="amount"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-warning="state in ('pending', 'review')"/>
                <field name="pos_order_id"/>
                <field name="attempts" optional="show"/>
                <field name="error" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="feria_pos_link_view_form" model="ir.ui.view">
        <field name="name">feria.pos.link.view.form</field>
        <field name="model">feria.pos.link</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_retry" type="object" string="Reintentar el envio" class="btn-primary"
                            invisible="state != 'pending'" groups="feria_saldo.group_feria_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="movement_id"/>
                            <field name="partner_id"/>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="pos_order_id"/>
                            <field name="attempts"/>
                        </group>
                    </group>
                    <group invisible="not error">
                        <field name="error"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="feria_pos_link_view_search" model="ir.ui.view">
        <field name="name">feria.pos.link.view.search</field>
        <field name="model">feria.pos.link</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="pos_order_id"/>
                <filter name="pending" string="Pendientes de enviar" domain="[('state', '=', 'pending')]"/>
                <filter name="review" string="Para revisar" domain="[('state', '=', 'review')]"/>
                <filter name="done" string="Enviados" domain="[('state', '=', 'done')]"/>
            </search>
        </field>
    </record>

    <record id="feria_pos_link_action" model="ir.actions.act_window">
        <field name="name">Pedidos del TPV</field>
        <field name="res_model">feria.pos.link</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todavia no hay cobros vinculados con el TPV</p>
            <p>Activa "Vincular con el TPV de Odoo" en Ajustes.</p>
        </field>
    </record>

    <menuitem id="feria_menu_pos_links" name="Pedidos del TPV" parent="feria_saldo.feria_menu_operations"
              action="feria_pos_link_action" sequence="40"/>
</odoo>
