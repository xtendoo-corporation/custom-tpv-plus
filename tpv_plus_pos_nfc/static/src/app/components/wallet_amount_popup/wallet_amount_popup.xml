<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="tpv_plus_pos_nfc.WalletAmountPopup">
        <Dialog title="props.title || 'Cantidad a usar'" size="'md'" contentClass="'wallet-popup'">
            <div class="wallet-popup-body">
                <div class="wallet-customer-name" t-out="props.partnerName"/>
                <div class="wallet-hint">
                    Saldo <t t-out="formattedBalance"/><t t-out="props.currencySymbol"/>
                    · Total <t t-out="formattedTotal"/><t t-out="props.currencySymbol"/>
                </div>

                <div class="wallet-amount-field">
                    <input type="number" inputmode="decimal" step="0.01" min="0"
                           class="form-control wallet-amount-input"
                           t-model="state.amount"
                           t-ref="amountInput"
                           t-on-keydown="(ev) => ev.key === 'Enter' &amp;&amp; onConfirm()"/>
                    <span class="wallet-amount-currency" t-out="props.currencySymbol"/>
                </div>
                <div t-if="state.error" class="wallet-warning" t-out="state.error"/>

                <div class="wallet-shortcuts">
                    <button t-foreach="shortcuts" t-as="value" t-key="value"
                            class="btn btn-outline-secondary wallet-shortcut"
                            t-on-click="() => this.setAmount(value)">
                        <t t-out="value"/><t t-out="props.currencySymbol"/>
                    </button>
                    <button class="btn btn-outline-secondary wallet-shortcut" t-on-click="() => this.setAmount(maxAmount)">Máx</button>
                </div>
            </div>
            <t t-set-slot="footer">
                <div class="wallet-actions">
                    <button class="btn btn-primary wallet-btn" t-on-click="onConfirm">Confirmar pago</button>
                    <button class="btn btn-link wallet-cancel" t-on-click="onCancel">Volver</button>
                </div>
            </t>
        </Dialog>
    </t>
</templates>
