<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="tpv_plus_pos_nfc.WalletAmountPopup">
        <Dialog title="props.title || 'Cantidad a usar'" size="'md'" contentClass="'wallet-popup'">
            <div class="wallet-popup-body">
                <div class="wallet-figures">
                    <div class="wallet-figure">
                        <span>Total</span>
                        <strong t-out="formatMoney(props.orderTotal)"/>
                    </div>
                    <div class="wallet-figure">
                        <span>Saldo</span>
                        <strong t-out="formatMoney(props.walletBalance)"/>
                    </div>
                </div>

                <div class="wallet-amount-display" t-att-class="{'is-over': isOver}">
                    <small>Pagas con monedero</small>
                    <t t-out="state.text or '0'"/> €
                </div>
                <div t-if="isOver" class="wallet-warning">
                    El máximo que puedes usar es <t t-out="formatMoney(maxAmount)"/>
                </div>
                <div t-else="" class="wallet-remaining" t-att-class="{'is-done': isFullyCovered}">
                    <span t-if="isFullyCovered">Pedido cubierto por completo</span>
                    <t t-else="">
                        <span>Resto a cobrar</span>
                        <strong t-out="formatMoney(remaining)"/>
                    </t>
                </div>

                <div class="wallet-keypad">
                    <button t-foreach="keys" t-as="key" t-key="key"
                            class="btn wallet-key" t-att-class="key === 'half' or key === 'max' ? 'btn-outline-secondary wallet-key-quick' : 'btn-light'"
                            t-att-style="key === '0' ? 'grid-column: span 2' : ''"
                            t-on-click="() => this.onKey(key)">
                        <t t-if="key === 'half'">Mitad</t>
                        <t t-elif="key === 'max'">Máx</t>
                        <t t-else="" t-out="key"/>
                    </button>
                </div>
            </div>
            <t t-set-slot="footer">
                <div class="wallet-actions">
                    <t t-if="isFullyCovered and amount > 0">
                        <button class="btn btn-primary wallet-btn" t-att-disabled="!isValid" t-on-click="() => this.onConfirm()">
                            Pagar con monedero
                        </button>
                    </t>
                    <t t-else="">
                        <div class="wallet-methods">
                            <button t-foreach="props.paymentMethods || []" t-as="method" t-key="method.id"
                                    class="btn btn-primary wallet-btn" t-att-disabled="!isValid"
                                    t-on-click="() => this.onConfirm(method.id)">
                                <small>Cobrar resto con</small>
                                <t t-out="method.name"/>
                            </button>
                        </div>
                        <button t-if="!props.paymentMethods?.length" class="btn btn-secondary wallet-cancel" t-att-disabled="!isValid" t-on-click="() => this.onConfirm()">
                            Ir a pagar el resto
                        </button>
                    </t>
                </div>
            </t>
        </Dialog>
    </t>
</templates>
