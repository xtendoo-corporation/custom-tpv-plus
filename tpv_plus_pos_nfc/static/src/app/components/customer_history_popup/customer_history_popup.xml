<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="tpv_plus_pos_nfc.CustomerHistoryPopup">
        <Dialog title="'Historial · ' + this.props.partnerName" size="'md'" contentClass="'history-popup'" footer="false">
            <div class="history-balance">
                <span>Saldo monedero</span>
                <strong t-out="this.formatMoney(this.state.data.balance)"/>
            </div>
            <div class="history-tabs">
                <button class="btn" t-att-class="this.state.tab === 'wallet' ? 'btn-primary' : 'btn-light'" t-on-click="() => this.state.tab = 'wallet'">Monedero</button>
                <button class="btn" t-att-class="this.state.tab === 'orders' ? 'btn-primary' : 'btn-light'" t-on-click="() => this.state.tab = 'orders'">Pedidos</button>
            </div>

            <div t-if="this.state.loading" class="history-empty">Cargando…</div>
            <div t-elif="this.state.error" class="history-empty text-danger">No se pudo cargar el historial</div>

            <t t-elif="this.state.tab === 'wallet'">
                <div t-if="!this.state.data.wallet_moves.length" class="history-empty">Sin movimientos de monedero</div>
                <div t-foreach="this.state.data.wallet_moves" t-as="move" t-key="move.id" class="history-row">
                    <div class="history-main">
                        <div class="history-title" t-out="move.description"/>
                        <div class="history-date" t-out="this.formatDate(move.date)"/>
                    </div>
                    <strong class="history-amount" t-att-class="this.moveAmount(move) >= 0 ? 'is-in' : 'is-out'">
                        <t t-if="this.moveAmount(move) >= 0">+</t><t t-out="this.formatMoney(this.moveAmount(move))"/>
                    </strong>
                </div>
            </t>

            <t t-else="">
                <div t-if="!this.state.data.orders.length" class="history-empty">Sin pedidos</div>
                <div t-foreach="this.state.data.orders" t-as="order" t-key="order.id" class="history-order">
                    <div class="history-row" t-on-click="() => this.toggleOrder(order.id)">
                        <div class="history-main">
                            <div class="history-title" t-out="order.name"/>
                            <div class="history-date">
                                <t t-out="this.formatDate(order.date)"/>
                                <t t-foreach="order.payments" t-as="payment" t-key="payment_index">
                                    · <t t-out="payment.method"/>
                                </t>
                            </div>
                        </div>
                        <strong class="history-amount" t-out="this.formatMoney(order.total)"/>
                    </div>
                    <div t-if="this.state.openOrderId === order.id" class="history-lines">
                        <div t-foreach="order.lines" t-as="line" t-key="line_index" class="history-line">
                            <span><t t-out="line.qty"/> × <t t-out="line.name"/></span>
                            <span t-out="this.formatMoney(line.total)"/>
                        </div>
                    </div>
                </div>
            </t>
        </Dialog>
    </t>
</templates>
