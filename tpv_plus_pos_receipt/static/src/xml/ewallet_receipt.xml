<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t t-name="tpv_plus_pos_receipt.EWalletReceipt"
       t-inherit="point_of_sale.OrderReceipt"
       t-inherit-mode="extension">

        <xpath expr="//div[hasclass('after-footer')]" position="before">
            <t t-set="eWalletInfo" t-value="order.getEWalletReceiptInfo ? order.getEWalletReceiptInfo() : []"/>
            <t t-if="eWalletInfo &amp;&amp; eWalletInfo.length &gt; 0">
                <div style="font-family: 'Lucida Console', 'DejaVu Sans Mono', monospace; font-size: 12px; text-align: center; margin: 4px 0; padding: 0;">
                    <div style="font-weight: bold; font-size: 13px; margin-bottom: 4px;">
                        SALDO MONEDERO ELECTRONICO
                    </div>
                    <t t-foreach="eWalletInfo" t-as="wallet" t-key="wallet_index">
                        <div style="margin-bottom: 2px;">
                            <div style="display: flex; justify-content: space-between; font-size: 12px;">
                                <span>Usado en esta compra:</span>
                                <span style="font-weight: bold;">
                                    -<t t-esc="(formatCurrency(wallet.amountUsed) || '').replaceAll('\u00A0','').replaceAll(' ','')"/>
                                </span>
                            </div>
                            <div style="display: flex; justify-content: space-between; font-size: 14px; font-weight: bold; margin-top: 2px;">
                                <span>Saldo restante:</span>
                                <span>
                                    <t t-esc="(formatCurrency(wallet.remainingBalance) || '').replaceAll('\u00A0','').replaceAll(' ','')"/>
                                </span>
                            </div>
                        </div>
                    </t>
                    <div style="border-top: 1px dashed black; margin: 4px 0;"/>
                </div>
            </t>
        </xpath>

    </t>
</templates>
