<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="feria_incident_view_list" model="ir.ui.view">
        <field name="name">feria.incident.view.list</field>
        <field name="model">feria.incident</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="create_date"/>
                <field name="type"/>
                <field name="partner_id"/>
                <field name="description"/>
                <field name="state" widget="badge" decoration-warning="state == 'open'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="feria_incident_view_form" model="ir.ui.view">
        <field name="name">feria.incident.view.form</field>
        <field name="model">feria.incident</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_resolve" type="object" string="Marcar resuelta" invisible="state == 'done'"
                            groups="feria_saldo.group_feria_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="type"/>
                        <field name="partner_id"/>
                        <field name="movement_id"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="feria_incident_view_search" model="ir.ui.view">
        <field name="name">feria.incident.view.search</field>
        <field name="model">feria.incident</field>
        <field name="arch" type="xml">
            <search>
                <filter name="open" string="Abiertas" domain="[('state', '=', 'open')]"/>
                <group>
                    <filter name="group_type" string="Tipo" context="{'group_by': 'type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="feria_incident_action" model="ir.actions.act_window">
        <field name="name">Incidencias</field>
        <field name="res_model">feria.incident</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>
