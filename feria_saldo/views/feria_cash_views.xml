<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="feria_cash_view_list" model="ir.ui.view">
        <field name="name">feria.cash.view.list</field>
        <field name="model">feria.cash</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-info="kind == 'count'" decoration-bf="kind == 'close'"
                  decoration-danger="difference != 0">
                <field name="date"/>
                <field name="kind"/>
                <field name="opening_float" optional="show"/>
                <field name="recharges" optional="show"/>
                <field name="refunds" optional="show"/>
                <field name="card_recharges" optional="hide"/>
                <field name="expected"/>
                <field name="counted"/>
                <field name="difference"/>
                <field name="kept"/>
                <field name="withdrawn" sum="Retirado"/>
                <field name="sales" optional="hide"/>
                <field name="note" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="feria_cash_view_form" model="ir.ui.view">
        <field name="name">feria.cash.view.form</field>
        <field name="model">feria.cash</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group string="Periodo">
                            <field name="kind"/>
                            <field name="date"/>
                            <field name="period_start"/>
                            <field name="movements_count"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Efectivo">
                            <field name="opening_float"/>
                            <field name="recharges"/>
                            <field name="refunds"/>
                            <field name="card_recharges"/>
                            <field name="expected"/>
                            <field name="counted"/>
                            <field name="difference"/>
                        </group>
                    </group>
                    <group>
                        <group string="Cierre" invisible="kind != 'close'">
                            <field name="kept"/>
                            <field name="withdrawn"/>
                        </group>
                        <group string="Informativo">
                            <field name="sales"/>
                            <field name="note"/>
                            <field name="uuid"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="feria_cash_view_search" model="ir.ui.view">
        <field name="name">feria.cash.view.search</field>
        <field name="model">feria.cash</field>
        <field name="arch" type="xml">
            <search>
                <filter name="close" string="Cierres" domain="[('kind', '=', 'close')]"/>
                <filter name="count" string="Recuentos" domain="[('kind', '=', 'count')]"/>
                <filter name="mismatch" string="Con diferencia" domain="[('difference', '!=', 0)]"/>
                <group>
                    <filter name="group_day" string="Dia" context="{'group_by': 'date:day'}"/>
                    <filter name="group_kind" string="Tipo" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="feria_cash_action" model="ir.actions.act_window">
        <field name="name">Cierres y recuentos de caja</field>
        <field name="res_model">feria.cash</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todavia no se ha contado ni cerrado la caja</p>
            <p>Se hace desde la pantalla de caja con el boton "Caja", junto a ONLINE.</p>
        </field>
    </record>
</odoo>
