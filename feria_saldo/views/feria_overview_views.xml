<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="feria_overview_view_form" model="ir.ui.view">
        <field name="name">feria.overview.view.form</field>
        <field name="model">feria.overview</field>
        <field name="arch" type="xml">
            <form string="Resumen" create="0" edit="0" delete="0">
                <header>
                    <button name="action_refresh" type="object" string="Actualizar" class="btn-primary"/>
                    <button name="action_open_charges" type="object" string="Pedidos (cobros)"/>
                    <button name="action_open_recharges" type="object" string="Recargas"/>
                    <button name="action_open_balances" type="object" string="Saldos de clientes"/>
                    <button name="action_open_cash" type="object" string="Cierres de caja"/>
                    <button name="action_open_desk" type="object" string="Abrir pantalla de caja"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Resumen de TpvPlus</h1>
                        <p class="text-muted">Lo que esta pasando ahora. Pulsa "Actualizar" para ver los datos de este momento.</p>
                    </div>
                    <field name="currency_id" invisible="1"/>
                    <group name="figures">
                        <group string="Hoy" name="today">
                            <field name="today_recharges"/>
                            <field name="today_recharges_count"/>
                            <field name="today_card_recharges"/>
                            <field name="today_charges"/>
                            <field name="today_charges_count"/>
                            <field name="last_movement_at"/>
                        </group>
                        <group string="Dinero" name="money">
                            <field name="balance_total"/>
                            <field name="cash_expected"/>
                            <field name="last_close_date"/>
                            <field name="last_close_kept"/>
                        </group>
                    </group>
                    <group name="status" string="Estado">
                        <group>
                            <field name="customers"/>
                        </group>
                    </group>
                    <separator string="Ultimas operaciones"/>
                    <field name="recent_movement_ids" nolabel="1" readonly="1">
                        <list>
                            <field name="received_at"/>
                            <field name="partner_id"/>
                            <field name="type"/>
                            <field name="amount"/>
                            <field name="balance_after"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="feria_overview_action" model="ir.actions.server">
        <field name="name">Resumen</field>
        <field name="model_id" ref="model_feria_overview"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open()</field>
    </record>
</odoo>
