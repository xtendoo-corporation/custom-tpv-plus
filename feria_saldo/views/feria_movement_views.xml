<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="feria_movement_view_list" model="ir.ui.view">
        <field name="name">feria.movement.view.list</field>
        <field name="model">feria.movement</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="received_at"/>
                <field name="partner_id"/>
                <field name="type"/>
                <field name="payment_method" optional="show"/>
                <field name="amount" sum="Total"/>
                <field name="signed_amount" sum="Efecto neto"/>
                <field name="balance_after"/>
                <field name="state" optional="show"/>
                <field name="uuid" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="feria_movement_view_form" model="ir.ui.view">
        <field name="name">feria.movement.view.form</field>
        <field name="model">feria.movement</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_cancel" type="object" string="Anular" class="btn-secondary"
                            invisible="state != 'confirmed' or type == 'ANULACION'"
                            groups="feria_saldo.group_feria_manager"
                            confirm="Se creara un contra-movimiento. Continuar?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="uuid"/>
                            <field name="partner_id"/>
                            <field name="code_used"/>
                            <field name="type"/>
                            <field name="payment_method" invisible="type not in ('RECARGAR', 'ANULACION')"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount"/>
                            <field name="signed_amount"/>
                            <field name="balance_after"/>
                            <field name="ref_movement_id"/>
                            <field name="note"/>
                        </group>
                        <group>
                            <field name="created_at_device"/>
                            <field name="received_at"/>
                            <field name="sequence"/>
                            <field name="hash_prev"/>
                            <field name="hash"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="feria_movement_view_search" model="ir.ui.view">
        <field name="name">feria.movement.view.search</field>
        <field name="model">feria.movement</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="uuid"/>
                <field name="code_used"/>
                <filter name="collect" string="Cobros" domain="[('type', '=', 'COBRAR')]"/>
                <filter name="topup" string="Recargas" domain="[('type', '=', 'RECARGAR')]"/>
                <filter name="topup_cash" string="Recargas en efectivo" domain="[('type', '=', 'RECARGAR'), ('payment_method', '!=', 'card')]"/>
                <filter name="topup_card" string="Recargas con tarjeta" domain="[('type', '=', 'RECARGAR'), ('payment_method', '=', 'card')]"/>
                <filter name="adjust" string="Ajustes y anulaciones" domain="[('type', 'in', ('AJUSTE', 'ANULACION'))]"/>
                <separator/>
                <filter name="today" string="Hoy" domain="[('received_at', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0, 0, 0)).to_utc())]"/>
                <group>
                    <filter name="group_type" string="Tipo" context="{'group_by': 'type'}"/>
                    <filter name="group_payment" string="Pago de la recarga" context="{'group_by': 'payment_method'}"/>
                    <filter name="group_day" string="Dia" context="{'group_by': 'received_at:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="feria_movement_view_pivot" model="ir.ui.view">
        <field name="name">feria.movement.view.pivot</field>
        <field name="model">feria.movement</field>
        <field name="arch" type="xml">
            <pivot string="Cierre">
                <field name="received_at" interval="day" type="row"/>
                <field name="type" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="feria_movement_action" model="ir.actions.act_window">
        <field name="name">Movimientos</field>
        <field name="res_model">feria.movement</field>
        <field name="view_mode">list,form,pivot</field>
    </record>

    <record id="feria_movement_action_charges" model="ir.actions.act_window">
        <field name="name">Pedidos (cobros)</field>
        <field name="res_model">feria.movement</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="domain">[('type', '=', 'COBRAR')]</field>
        <field name="context">{'search_default_group_day': 1}</field>
    </record>

    <record id="feria_movement_action_recharges" model="ir.actions.act_window">
        <field name="name">Recargas</field>
        <field name="res_model">feria.movement</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="domain">[('type', '=', 'RECARGAR')]</field>
        <field name="context">{'search_default_group_day': 1}</field>
    </record>

    <record id="feria_movement_action_closing" model="ir.actions.act_window">
        <field name="name">Cierre por dispositivo y operador</field>
        <field name="res_model">feria.movement</field>
        <field name="view_mode">pivot,list,form</field>
        <field name="domain">[('state', '=', 'confirmed')]</field>
        <field name="context">{'search_default_today': 1}</field>
    </record>

</odoo>
