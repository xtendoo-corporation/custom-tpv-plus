<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_feria" model="res.groups.privilege">
        <field name="name">TpvPlus</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_feria_user" model="res.groups">
        <field name="name">Consulta</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_feria"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_feria_manager" model="res.groups">
        <field name="name">Gestor</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_feria"/>
        <field name="implied_ids" eval="[Command.link(ref('group_feria_user')), Command.link(ref('base.group_partner_manager'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>
</odoo>
