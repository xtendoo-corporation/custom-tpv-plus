<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="feria_manual_movement_wizard_view_form" model="ir.ui.view">
        <field name="name">feria.manual.movement.wizard.view.form</field>
        <field name="model">feria.manual.movement.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="partner_id" readonly="1"/>
                    <field name="type"/>
                    <field name="direction" invisible="type != 'AJUSTE'" required="type == 'AJUSTE'"/>
                    <field name="amount" placeholder="0.00"/>
                    <field name="note" required="type == 'AJUSTE'"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirmar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
